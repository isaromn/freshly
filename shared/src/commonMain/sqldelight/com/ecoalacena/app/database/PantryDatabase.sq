-- Offline-first pantry storage. This table is the single source of truth (SSOT).
-- category stores the name of the Category enum (e.g. 'DAIRY').
-- expirationDate is an epoch timestamp in milliseconds (NULL = does not expire).
-- isOrganic is stored as 0/1 and converted to Boolean in the repository.
CREATE TABLE pantryItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'OTHER',
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    expirationDate INTEGER,
    isOrganic INTEGER NOT NULL DEFAULT 0,
    -- Nutrition per 100 g / 100 ml, or per piece or pack (see PantryItem.nutritionBasis). NULL = unknown.
    caloriesPerUnit INTEGER,
    proteinGrams REAL,
    carbsGrams REAL,
    fatGrams REAL
);

-- One row per product consumed before it expired; summed for the "waste avoided" metric.
CREATE TABLE savedFoodEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    kg REAL NOT NULL,
    savedAt INTEGER NOT NULL,
    -- Estimated kcal of the food that was eaten in time; NULL when unknown.
    calories REAL,
    -- Estimated grams of protein of that food; NULL when unknown.
    proteinGrams REAL
);

selectAll:
SELECT *
FROM pantryItemEntity
ORDER BY name COLLATE NOCASE ASC;

selectById:
SELECT *
FROM pantryItemEntity
WHERE id = ?;

insertItem:
INSERT OR REPLACE INTO pantryItemEntity(
    id, name, category, quantity, unit, expirationDate, isOrganic,
    caloriesPerUnit, proteinGrams, carbsGrams, fatGrams
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM pantryItemEntity
WHERE id = ?;

-- Items that expire on or before :threshold (this includes items already expired).
-- Rows with a NULL expirationDate never match the comparison, so they are excluded.
-- Do not add `IS NOT NULL` here: it makes SQLDelight generate a separate result class
-- instead of reusing PantryItemEntity.
selectExpiringSoon:
SELECT *
FROM pantryItemEntity
WHERE expirationDate <= :threshold
ORDER BY expirationDate ASC;

insertSavedFood:
INSERT INTO savedFoodEntity(kg, savedAt, calories, proteinGrams)
VALUES (?, ?, ?, ?);

selectTotalSavedKg:
SELECT COALESCE(SUM(kg), 0.0)
FROM savedFoodEntity;

selectTotalSavedCalories:
SELECT COALESCE(SUM(calories), 0.0)
FROM savedFoodEntity;

selectTotalSavedProtein:
SELECT COALESCE(SUM(proteinGrams), 0.0)
FROM savedFoodEntity;

-- What happened to items that left the pantry (kind = 'CONSUMED' or 'DISCARDED'), so the shopping
-- list can suggest buying them again.
CREATE TABLE pantryEventEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    kind TEXT NOT NULL,
    happenedAt INTEGER NOT NULL
);

-- Products the user added to the shopping list by hand.
CREATE TABLE shoppingItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    addedAt INTEGER NOT NULL
);

-- Suggestions the user removed from the shopping list, by normalised name. A suggestion comes back
-- only if the product is used up or expires again after it was dismissed.
CREATE TABLE shoppingDismissalEntity (
    nameKey TEXT NOT NULL PRIMARY KEY,
    dismissedAt INTEGER NOT NULL
);

insertEvent:
INSERT INTO pantryEventEntity(name, category, quantity, unit, kind, happenedAt)
VALUES (?, ?, ?, ?, ?, ?);

selectEventsSince:
SELECT *
FROM pantryEventEntity
WHERE happenedAt >= :since
ORDER BY happenedAt DESC;

selectShoppingItems:
SELECT *
FROM shoppingItemEntity
ORDER BY addedAt ASC;

insertShoppingItem:
INSERT OR REPLACE INTO shoppingItemEntity(id, name, addedAt)
VALUES (?, ?, ?);

deleteShoppingItem:
DELETE FROM shoppingItemEntity
WHERE id = ?;

selectDismissals:
SELECT *
FROM shoppingDismissalEntity;

insertDismissal:
INSERT OR REPLACE INTO shoppingDismissalEntity(nameKey, dismissedAt)
VALUES (?, ?);
